# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# Base URL of the SAP Joule / SAP AI service endpoint.
JOULE_BASE_URL=https://example.sap.com/joule

# API key or token used to authenticate requests.
JOULE_API_KEY=

# Per-request timeout in seconds (optional, defaults to 30).
JOULE_TIMEOUT=30
